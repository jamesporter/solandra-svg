{
  "name": "solandra-svg",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "start": "vite --open",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint --type-aware",
    "preview": "vite preview",
    "test": "vitest",
